# Frontend (Vite). Optional build-time override; production prefers app_public_config.api_base_url.
# Never put secrets in VITE_ variables.
VITE_API_BASE_URL=https://YOUR-REAL-API-HOST

# Server-only Nest API environment (Render / Docker host — not Vercel frontend).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app origin used in invitation email accept links.
SG_PUBLIC_APP_URL=https://www.sentinelgrid.tech

# CORS allowlist (comma-separated). Must include the live Command origin.
CORS_ORIGINS=https://www.sentinelgrid.tech,https://sentinelgrid.tech,https://sentinelgrid-delta.vercel.app

# Email outbox + Resend worker. Store secrets in the host secret store — never commit values.
SG_EMAIL_TRANSPORT=resend
SG_EMAIL_WORKER_ENABLED=true
RESEND_API_KEY=your-resend-api-key
SG_EMAIL_FROM=SentinelGrid <noreply@your-verified-domain>

# Evidence payload object store (required for evidence ingest in production).
# local_dev is forbidden when NODE_ENV=production.
PAYLOAD_STORAGE_BACKEND=s3
S3_BUCKET=your-bucket
AWS_REGION=us-west-2
# Optional: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or rely on the host IAM role.
# Optional S3-compatible endpoint:
# S3_ENDPOINT=https://your-minio-or-r2-endpoint
# S3_FORCE_PATH_STYLE=true
