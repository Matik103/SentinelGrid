# Frontend (Vite). Set to the deployed NestJS API origin when it exists.
# This is public and is embedded into the browser bundle. Never put secrets in VITE_ variables.
VITE_API_BASE_URL=https://YOUR-REAL-API-HOST

# Server-only API environment (configure on the backend host, not Vercel frontend).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app origin used in invitation email accept links.
SG_PUBLIC_APP_URL=https://sentinelgrid-delta.vercel.app

# Email outbox + Resend worker (production). Store secrets in the host secret store — never commit values.
# Worker stays off unless SG_EMAIL_WORKER_ENABLED=true AND transport=resend AND both secrets are set.
SG_EMAIL_TRANSPORT=resend
SG_EMAIL_WORKER_ENABLED=true
RESEND_API_KEY=your-resend-api-key
SG_EMAIL_FROM=SentinelGrid <noreply@your-verified-domain>
